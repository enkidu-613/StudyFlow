# StudyFlow 服务端运行时数据库连接：
# 使用 Supavisor Session Pooler 的 5432 端口和独立登录角色，例如
# studyflow_server。该角色只授予迁移和应用所需的 schema、table、sequence
# 权限。不要使用 anon、authenticated、service_role 或 Supabase Data API Key。
# 独立角色不能具有 BYPASSRLS。只替换下面的占位符。
STUDYFLOW_DATABASE_URL=postgresql://studyflow_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# 集成测试数据库：必须是独立的 PostgreSQL 数据库，不能接触生产数据。
STUDYFLOW_TEST_DATABASE_URL=postgresql://studyflow_test:<password>@127.0.0.1:5432/studyflow_test

# 仅供服务端使用的认证密钥。使用下面命令分别生成两个不同的随机值：
#   openssl rand -hex 32
# 分别填入两个变量，通过 VPS 的秘密环境配置注入；不要打包到客户端，
# 也不要提交 infra/.env。
STUDYFLOW_BOOTSTRAP_TOKEN=<server-only-one-time-bootstrap-token>
STUDYFLOW_TOKEN_SIGNING_KEY=<server-only-random-value-at-least-32-bytes>

# Caddy 使用的公开 API 域名。Cloudflare A 记录应指向 VPS，且可开启代理。
STUDYFLOW_API_HOST=api.example.com

# infra/backup/backup.sh 使用的加密备份密码。尽量不要长期保存在 VPS，
# 可以在每次备份时临时注入；不要打印或提交。
STUDYFLOW_BACKUP_PASSPHRASE=<strong-random-passphrase>
STUDYFLOW_BACKUP_DIR=/var/backups/studyflow
