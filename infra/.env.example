# StudyFlow server runtime: use the Supabase session pooler URL for the
# long-lived FastAPI process. Replace only the placeholder values.
STUDYFLOW_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Integration tests: point to an isolated PostgreSQL database that can be
# migrated without touching production data.
STUDYFLOW_TEST_DATABASE_URL=postgresql://studyflow_test:<password>@127.0.0.1:5432/studyflow_test

# Server-only authentication secrets. Generate independent random values and
# inject them through the VPS secret environment; never bundle them in a client.
STUDYFLOW_BOOTSTRAP_TOKEN=<server-only-one-time-bootstrap-token>
STUDYFLOW_TOKEN_SIGNING_KEY=<server-only-random-value-at-least-32-bytes>
