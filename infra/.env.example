# StudyFlow 生产环境变量模板。
# 本文件只用于说明变量，不能直接作为生产配置。
# 在 VPS 的 infra/ 目录执行：
#   ./bootstrap-env.sh api.example.com
# 脚本会自动生成全部密钥并写入权限为 600 的 .env，且不打印敏感值。

# VPS 上 Docker 内网 PostgreSQL 数据库名与应用用户。
STUDYFLOW_POSTGRES_DB=studyflow
STUDYFLOW_POSTGRES_USER=studyflow_app
STUDYFLOW_POSTGRES_PASSWORD=GENERATED_BY_BOOTSTRAP_SCRIPT

# 完整的 PostgreSQL 连接 URL，由 bootstrap-env.sh 生成并填入已编码的密码。
# 服务端启动时自动转为 postgresql+asyncpg://。
STUDYFLOW_DATABASE_URL=GENERATED_BY_BOOTSTRAP_SCRIPT

# 仅供服务端使用的 JWT 签名密钥（至少 32 字节）。
STUDYFLOW_TOKEN_SIGNING_KEY=GENERATED_BY_BOOTSTRAP_SCRIPT

# Caddy 使用的公开 API 域名（Cloudflare A 记录指向 VPS，可开启代理）。
STUDYFLOW_API_HOST=api.example.com

# infra/backup/backup.sh 使用的加密备份密码；优先从密码管理器提供，
# 未提供时由 bootstrap-env.sh 生成并只显示一次。
STUDYFLOW_BACKUP_PASSPHRASE=GENERATED_BY_BOOTSTRAP_SCRIPT
STUDYFLOW_BACKUP_DIR=/var/backups/studyflow
