# StudyFlow server runtime: use a dedicated LOGIN role such as
# `studyflow_server` through the Supavisor session pooler on port 5432. Grant
# that role only the application schema/table/sequence privileges required by
# migrations; do
# not use `anon`, `authenticated`, `service_role`, or a Supabase Data API key.
# The dedicated role must not have BYPASSRLS. Replace only placeholder values.
STUDYFLOW_DATABASE_URL=postgresql://studyflow_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Integration tests: point to an isolated PostgreSQL database that can be
# migrated without touching production data.
STUDYFLOW_TEST_DATABASE_URL=postgresql://studyflow_test:<password>@127.0.0.1:5432/studyflow_test

# Server-only authentication secrets. Generate independent random values and
# inject them through the VPS secret environment; never bundle them in a client.
STUDYFLOW_BOOTSTRAP_TOKEN=<server-only-one-time-bootstrap-token>
STUDYFLOW_TOKEN_SIGNING_KEY=<server-only-random-value-at-least-32-bytes>
