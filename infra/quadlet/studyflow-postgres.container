[Unit]
Description=StudyFlow PostgreSQL

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=studyflow-postgres
EnvironmentFile=/home/studyflow/app/StudyFlow/infra/.env
Volume=studyflow-postgres.volume:/var/lib/postgresql/data
Network=studyflow.network
HealthCmd=pg_isready -U studyflow_app -d studyflow
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=900
