#!/usr/bin/env bash
set -euo pipefail

tool_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$tool_dir/.." && pwd)"
cache_root="${STUDYFLOW_TOOL_CACHE:-$repo_root/.tool-cache}"

export CI=true
export FLUTTER_SUPPRESS_ANALYTICS=true
export DART_SUPPRESS_ANALYTICS=true
export PUB_CACHE="${PUB_CACHE:-$cache_root/pub-cache}"

# Keep Flutter and direct Gradle builds on the same Android-compatible JDK.
source "$tool_dir/android-java-env.sh"

flutter_bin=""
if [[ -n "${STUDYFLOW_FLUTTER_ROOT:-}" ]]; then
  flutter_bin="$STUDYFLOW_FLUTTER_ROOT/bin/flutter"
elif [[ -f "$cache_root/flutter-sdk/bin/flutter" ]]; then
  flutter_bin="$cache_root/flutter-sdk/bin/flutter"
elif command -v mise >/dev/null 2>&1; then
  flutter_bin="$(mise which flutter 2>/dev/null || true)"
elif command -v flutter >/dev/null 2>&1; then
  flutter_bin="$(command -v flutter)"
fi

if [[ -z "$flutter_bin" || ! -f "$flutter_bin" ]]; then
  cat >&2 <<EOF
StudyFlow Flutter SDK was not found.
Install the pinned toolchain with mise, or set STUDYFLOW_FLUTTER_ROOT to a
writable Flutter SDK directory. The expected version is listed in mise.toml.
EOF
  exit 127
fi

exec bash "$flutter_bin" "$@"
